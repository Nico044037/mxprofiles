rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isModerator() {
      return request.auth != null
        && (get(/databases/$(database)/documents/usernames/nico).data.uid == request.auth.uid
          || (exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
            && get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.active == true));
    }
    function isRestricted(uid) {
      return exists(/databases/$(database)/documents/accountStatus/$(uid))
        && get(/databases/$(database)/documents/accountStatus/$(uid)).data.status in ['banned', 'terminated', 'deleted'];
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !isRestricted(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{1,64}
      allow update: if (request.auth != null
        && request.auth.uid == uid
        && !isRestricted(uid)
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.isModerator == resource.data.isModerator)
        || (isModerator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username);
      allow delete: if (request.auth != null && request.auth.uid == uid) || isModerator();
    }
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{1,64}$');
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isModerator();
    }
    match /accountStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isModerator());
      allow create, update: if isModerator()
        && request.resource.data.status in ['banned', 'terminated', 'deleted']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300;
      allow delete: if isModerator();
    }
  }
})
        && (!("isModerator" in request.resource.data) || request.resource.data.isModerator == false);
      allow update: if (request.auth != null
        && request.auth.uid == uid
        && !isRestricted(uid)
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username == resource.data.username)
        || (isModerator()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username);
      allow delete: if (request.auth != null && request.auth.uid == uid) || isModerator();
    }
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{1,64}$');
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isModerator();
    }
    match /accountStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isModerator());
      allow create, update: if isModerator()
        && request.resource.data.status in ['banned', 'terminated', 'deleted']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300;
      allow delete: if isModerator();
    }
  }
}